# ==============================================================================
# EXPENSE TRACKER BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your production values.
# ==============================================================================

# Server Port (Coolify/Render auto-assigns or defaults to 5000 / 3000)
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (TiDB Cloud Serverless)
# ------------------------------------------------------------------------------
# TiDB Cloud Serverless MySQL Connection String (recommended):
# Format: mysql://<username>:<password>@<host>:4000/<database>?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://3JQ2tqoLkDYoKmG.root:POwHEhH89YDdGiiD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test?ssl={"rejectUnauthorized":true}

# Or discrete connection parameters (alternative):
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=3JQ2tqoLkDYoKmG.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=test
# DB_SSL=true

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_byte_hex_string
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_byte_hex_string

# ------------------------------------------------------------------------------
# 3. CORS & ORIGIN SETTINGS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://expense-tracker-frontend-sx16.onrender.com,https://expense-tracker-admin.onrender.com,http://localhost:5173
CORS_ORIGINS=https://expense-tracker-frontend-sx16.onrender.com,https://expense-tracker-admin.onrender.com,http://localhost:5173
FRONTEND_URL=https://expense-tracker-frontend-sx16.onrender.com
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 4. RATE LIMITING
# ------------------------------------------------------------------------------
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH & FIREBASE (Optional / Social Auth)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=134393964411-ppnie745kfm42mrqkk6uptn7srkta8j1.apps.googleusercontent.com
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_firebase_json

# ------------------------------------------------------------------------------
# 6. EMAIL CONFIGURATION (Gmail App Password for Password Reset)
# ------------------------------------------------------------------------------
EMAIL_USER=sandeepdhakar285@gmail.com
EMAIL_PASS=your_gmail_app_password

# ------------------------------------------------------------------------------
# 7. DEFAULT ADMIN CONFIGURATION (for create_admin script)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=sandeep@gmail.com
ADMIN_PASSWORD=Admin@123
